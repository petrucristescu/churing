(executable
 (name gen_version)
 (modules gen_version))

(rule
 (target version.ml)
 (deps ../VERSION)
 (action
  (with-stdout-to %{target}
   (run %{exe:gen_version.exe} %{dep:../VERSION}))))

(library
 (name churing_lib)
 (modules parser eval ast types infer version)
 (libraries unix)
 (wrapped false)
 (flags (:standard -w -27)))

(executable
 (name churing)
 (modules churing)
 (libraries churing_lib)
 (flags (:standard -w -27)))
